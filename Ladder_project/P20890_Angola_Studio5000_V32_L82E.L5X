              <Rung Number="6" Type="N">
                <Comment>
                  <![CDATA[DG_7404_004 (On-Card Scaling): load channel PV and setpoints into AI_Inst_DG_7404_004 and execute AOI_AI_Channel.]]>
                </Comment>
                <Text>
                  <![CDATA[MOV(DG_7404_004,AI_Inst_DG_7404_004.PV)MOV(20.0,AI_Inst_DG_7404_004.LoAlarmSP)MOV(30.0,AI_Inst_DG_7404_004.HiAlarmSP)MOV(-10.0,AI_Inst_DG_7404_004.LoFaultSP)MOV(98.0,AI_Inst_DG_7404_004.HiFaultSP)[OTU(AI_Inst_DG_7404_004.LoAlarmLE),OTL(AI_Inst_DG_7404_004.HasLoAlarm),OTL(AI_Inst_DG_7404_004.HasHiAlarm),OTL(AI_Inst_DG_7404_004.AllowHiLatch),OTU(AI_Inst_DG_7404_004.HasFaultWin),XIC(DG_7404_004_INH)OTE(AI_Inst_DG_7404_004.Inhibit),XIC(System_Reset)OTE(AI_Inst_DG_7404_004.SystemReset),XIC(System_AnyActions)OTE(AI_Inst_DG_7404_004.AnyActions)]AOI_AI_Channel(AI_Inst_DG_7404_004);]]>
                </Text>
