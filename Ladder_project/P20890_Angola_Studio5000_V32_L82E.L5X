        </Description>
      </Tag>
      <Tag Name="DF_7404_001_ALH" TagType="Base" DataType="BOOL">
        <Description>
          <![CDATA[7404-DF-001  Flame detector pump house - Fire Alarm | GE address %M00364 (BOOL), initial 1, retentive NO]]>
        </Description>
      </Tag>
      <Tag Name="DF_7404_001_ALHI" TagType="Base" DataType="BOOL">
