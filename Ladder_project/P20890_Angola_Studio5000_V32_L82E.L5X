          <![CDATA[7404-DF-001  Flame detector pump house - Open circuit | GE address %M00484 (BOOL), initial 0, retentive NO]]>
        </Description>
      </Tag>
      <Tag Name="DF_7404_001_SC" TagType="Base" DataType="BOOL">
        <Description>
          <![CDATA[7404-DF-001  Flame detector pump house - Short circuit | GE address %M00508 (BOOL), initial 0, retentive NO]]>
        </Description>
      </Tag>
      <Tag Name="DF_7404_001_VAL" TagType="Base" DataType="REAL">
        <Description>
          <![CDATA[7404-DF-001  Flame detector pump house - Converted value | GE address %R00023 (INT), initial 0, retentive YES]]>
        </Description>
      </Tag>
      <Tag Name="DF_7404_002" TagType="Base" DataType="REAL">
        <Description>
          <![CDATA[7404-DF-002  Flame detector pump house | GE address %AI0013 (INT), initial 0, retentive YES]]>
