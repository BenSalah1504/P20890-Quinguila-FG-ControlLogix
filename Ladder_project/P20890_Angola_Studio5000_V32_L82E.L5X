<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="32.00" TargetName="P20890_Angola_L82E" TargetType="Controller" ContainsContext="false" Owner="EPPM Angola" ExportDate="Wed Nov 11 12:00:00 2026" ExportOptions="NoRawData L5KData">
  <Controller Use="Target" Name="P20890_Angola_L82E" ProcessorType="1756-L82E" MajorRev="32" MinorRev="11" TimeSlice="20" ShareUnusedTimeSlice="1" ProjectCreationDate="Wed Nov 11 12:00:00 2026" LastModifiedDate="Wed Nov 11 12:00:00 2026" SFCExecutionControl="CurrentActive" SFCRestartPosition="MostRecent" SFCLastScan="DontScan" ProjectSN="16#0000_0000" MatchProjectToController="false" InhibitAutomaticFirmwareUpdate="0">
    <Description>
      <![CDATA[Quinguila Fire & Gas panel P20890 (Angola) - conversion of the GE Fanuc VersaMax Proficy Machine Edition 3.00 SP6 ladder program to RSLogix 5000 v17 ladder. Behavioural rung-for-rung conversion; hardware-neutral (Emulator) with field I/O as named controller tags. Legacy behaviour preserved including the active-low shutdown outputs. NOT certified or field-proven: independent engineering review, I/O checkout and SAT are required before deployment.]]>
    </Description>
