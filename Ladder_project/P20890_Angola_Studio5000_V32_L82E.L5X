      <Tag Name="TMR_C_E_Delay" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[ONDTR TENTHS on Logic rung 11, GE register System_C_E_Delay %R00202, PV 1200 tenths = 120000 ms (120 s), R pin = #ALW_OFF %S00008 (never resets). Drives flag T00002 %T00002.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_DelugeFail" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for the GE ONDTR TENTHS of CE_LOG rung 18 (retentive on-delay, cleared by the derived RES rung), GE timer register Pump_Timer7 %R00227, preset 600 tenths = 60000 ms (60 s); its done bit drives DelugeFailedToRelease %M00620.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_HMI_Reset" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[ONDTR TENTHS on Logic rung 5, GE register System_HMI_Reset_Timer %R00205, PV 50 tenths = 5000 ms (5 s), R pin = System_Reset_HMI_Help %M00704. Timer helper name used because the GE register is a WORD array, not a Logix TIMER.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_Pump_Timer10" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[ONDTR TENTHS on Protect rung 13 - GE timer register Pump_Timer10 %R00236 (WORD[3] in var.xml), PV 700 tenths = 70000 ms (70.0 s). Its .DN drives %M00295 PUMP_B_START_OC (open circuit).]]>
        </Description>
      </Tag>
      <Tag Name="TMR_Pump_Timer11" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[ONDTR TENTHS on Protect rung 7 - GE timer register Pump_Timer11 %R00239 (WORD[3] in var.xml), PV 280 tenths = 28000 ms (28.0 s). Its .DN drives %T00013.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_Pump_Timer12" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[ONDTR TENTHS on Protect rung 11 - GE timer register Pump_Timer12 %R00242 (WORD[3] in var.xml), PV 280 tenths = 28000 ms (28.0 s). Its .DN drives %T00014.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_Pump_Timer9" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[ONDTR TENTHS on Protect rung 9 - GE timer register Pump_Timer9 %R00233 (WORD[3] in var.xml), PV 700 tenths = 70000 ms (70.0 s). Its .DN drives %M00293 PUMP_A_OC (open circuit).]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T00003" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for GE ONDTR TENTHS %T00003 in CE_LOG rung 11 (ONDTR = retentive on-delay, accumulated value kept when the rung goes false; cleared by the derived RES rung), preset 300 tenths = 30000 ms (30 s), GE timer register Pump_Timer1 %R00209.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T00004" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for GE TMR TENTHS %T00004 in CE_LOG rung 12 (TMR = non-retentive on-delay), preset 20 tenths = 2000 ms (2 s), GE timer register Pump_Timer2 %R00212.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T00005" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for GE TMR TENTHS %T00005 in CE_LOG rung 13 (non-retentive on-delay), preset 600 tenths = 60000 ms (60 s), GE timer register Pump_Timer3 %R00215.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T00006" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for GE TMR TENTHS %T00006 in CE_LOG rung 14 (non-retentive on-delay), preset 20 tenths = 2000 ms (2 s), GE timer register Pump_Timer4 %R00218.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T00007" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for GE TMR TENTHS %T00007 in CE_LOG rung 15 (non-retentive on-delay), preset 600 tenths = 60000 ms (60 s), GE timer register Pump_Timer5 %R00221.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T00008" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for GE TMR TENTHS %T00008 in CE_LOG rung 16 (non-retentive on-delay), preset 20 tenths = 2000 ms (2 s), GE timer register Pump_Timer6 %R00224.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T00009" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[TON for GE TMR TENTHS %T00009 in CE_LOG rung 20 (non-retentive on-delay), preset 20 tenths = 2000 ms (2 s), GE timer register Pump_Timer8 %R00230.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T_MIN" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[Helper TIMER for the T_MIN_PULSE generator. TON preset 60000 ms, self-resetting on its own .DN (free-running 60 s ramp); T_MIN_PULSE is taken from .ACC < 30000.]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T_SEC" TagType="Base" DataType="TIMER">
        <Description>
          <![CDATA[Helper TIMER for the T_SEC_PULSE generator. TON preset 1000 ms, self-resetting on its own .DN (free-running 1 s ramp); T_SEC_PULSE is taken from .ACC < 500.]]>
        </Description>
      </Tag>
      <Tag Name="T_MIN_PULSE" TagType="Base" DataType="BOOL">
        <Description>
          <![CDATA[Generated replacement for GE system bit #T_MIN %S00006 ('1.0 minute timer contact'): free-running 60 s square wave, 30 s TRUE / 30 s FALSE. Same tag already declared for the Logic routine - this entry only makes Protect self-contained.]]>
        </Description>
      </Tag>
      <Tag Name="T_SEC_PULSE" TagType="Base" DataType="BOOL">
        <Description>
          <![CDATA[Generated replacement for GE system bit #T_SEC (%S00005): free-running 1 s square wave, 0.5 s TRUE / 0.5 s FALSE. Declared here because the VersaMax supplied it in hardware.]]>
        </Description>
      </Tag>
      <Tag Name="OS_AnyActions" TagType="Base" DataType="BOOL">
        <Description>
          <![CDATA[ONS storage bit for the System_AnyActions first-up pulse (CE_LOG last rung)]]>
        </Description>
      </Tag>
      <Tag Name="Sys_MinorFaultBits" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
        <Description>
          <![CDATA[Copy of FaultLog.MinorFaultBits (GSV) - bit3 I/O, bit4 program, bit6 watchdog, bit10 battery]]>
        </Description>
      </Tag>
      <Tag Name="Sys_FaultClearZero" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
        <Description>
          <![CDATA[Constant 0 written by SSV to FaultLog.MinorFaultBits on System_Reset (replaces GE SVC_REQ 14)]]>
        </Description>
      </Tag>
