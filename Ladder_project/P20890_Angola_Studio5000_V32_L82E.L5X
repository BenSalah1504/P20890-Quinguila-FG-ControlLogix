    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="AOI_AI_Channel" Revision="2.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-11-12T12:00:00.000Z" CreatedBy="conversion" EditedDate="2026-11-12T13:00:00.000Z" EditedBy="conversion" SoftwareRevision="v17.00">
        <Description>
          <![CDATA[Unified Analog Input Channel AOI for On-Card Scaling (Engineering Units in REAL). Performs alarm/fault detection, latching, inhibit masking, First-Up capture, and optional optical fault window with local instance memory. No software scaling math is required because scaling is handled directly on the analog card.]]>
        </Description>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false"/>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false"/>
          <Parameter Name="PV" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[Scaled Process Variable directly from Analog Input Card (Engineering Units)]]>
            </Description>
          </Parameter>
          <Parameter Name="LoAlarmSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[Low Alarm Setpoint (Engineering Units)]]>
            </Description>
          </Parameter>
          <Parameter Name="HiAlarmSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[High Alarm Setpoint (Engineering Units)]]>
            </Description>
          </Parameter>
          <Parameter Name="LoFaultSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[Low Fault / Under-range Setpoint (Open Circuit)]]>
            </Description>
          </Parameter>
          <Parameter Name="HiFaultSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[High Fault / Over-range Setpoint (Short Circuit)]]>
            </Description>
          </Parameter>
          <Parameter Name="LoAlarmLE" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[0 = GEQ (High-acting/gas), 1 = LEQ (Low-acting/pressure trip)]]>
            </Description>
          </Parameter>
          <Parameter Name="HasLoAlarm" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[1 = Enable Low Alarm latch, 0 = Mask Low Alarm (e.g. Flame loops)]]>
            </Description>
          </Parameter>
          <Parameter Name="HasHiAlarm" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[1 = Enable High Alarm latch, 0 = Mask High Alarm (e.g. Low-only pressure PST_7002_001)]]>
            </Description>
          </Parameter>
          <Parameter Name="AllowHiLatch" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[1 = Normal, 0 = Block Hi Alarm latching (Flame detector interlock)]]>
            </Description>
          </Parameter>
          <Parameter Name="Inhibit" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[Channel Inhibit command]]>
            </Description>
          </Parameter>
          <Parameter Name="SystemReset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[System Reset command (unlatches alarms)]]>
            </Description>
          </Parameter>
          <Parameter Name="AnyActions" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[System Any Actions active (latches First-Up)]]>
            </Description>
          </Parameter>
          <Parameter Name="HasFaultWin" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[1 = Enable Diagnostic/Optical Fault Window, 0 = Disabled]]>
            </Description>
          </Parameter>
          <Parameter Name="FaultWinLo" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[Diagnostic Fault Window Lower Boundary]]>
            </Description>
          </Parameter>
          <Parameter Name="FaultWinHi" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[Diagnostic Fault Window Upper Boundary]]>
            </Description>
          </Parameter>
          <Parameter Name="Val" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="false">
            <Description>
              <![CDATA[Process Value output for HMI/SCADA]]>
            </Description>
          </Parameter>
          <Parameter Name="ALL" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[Low Alarm latched]]>
            </Description>
          </Parameter>
          <Parameter Name="ALLI" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[Low Alarm Inhibit-masked]]>
            </Description>
          </Parameter>
          <Parameter Name="ALH" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[High Alarm latched]]>
            </Description>
          </Parameter>
          <Parameter Name="ALHI" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[High Alarm Inhibit-masked]]>
            </Description>
          </Parameter>
          <Parameter Name="FRUP" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[First-Up trip latched]]>
            </Description>
          </Parameter>
          <Parameter Name="OC" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[Open Circuit / Under-range fault (live)]]>
            </Description>
          </Parameter>
          <Parameter Name="SC" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[Short Circuit / Over-range fault (live)]]>
            </Description>
          </Parameter>
          <Parameter Name="Fault1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
              <![CDATA[Optical / Diagnostic fault inside window (live)]]>
            </Description>
          </Parameter>
        </Parameters>
        <LocalTags>
          <LocalTag Name="LoAlarmRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="HiAlarmRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="LoFaultRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="HiFaultRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="TMR_OC" DataType="TIMER"/>
          <LocalTag Name="TMR_SC" DataType="TIMER"/>
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment>
                  <![CDATA[On-Card Scaling: PV is already scaled to Engineering Units by the analog input module; pass directly to Val.]]>
                </Comment>
                <Text>
                  <![CDATA[MOV(PV,Val);]]>
                </Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment>
                  <![CDATA[Lo Alarm compare: GEQ when LoAlarmLE=0 (standard high-acting/gas), LEQ when LoAlarmLE=1 (low-acting/low pressure trip).]]>
                </Comment>
                <Text>
                  <![CDATA[[XIO(LoAlarmLE)GEQ(Val,LoAlarmSP),XIC(LoAlarmLE)LEQ(Val,LoAlarmSP)]OTE(LoAlarmRaw);]]>
                </Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment>
                  <![CDATA[Hi Alarm compare (high gas / high pressure / fire).]]>
                </Comment>
                <Text>
                  <![CDATA[GEQ(Val,HiAlarmSP)OTE(HiAlarmRaw);]]>
                </Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment>
                  <![CDATA[Lo Fault compare: Open Circuit / signal under-range.]]>
                </Comment>
                <Text>
                  <![CDATA[LEQ(Val,LoFaultSP)OTE(LoFaultRaw);]]>
                </Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment>
                  <![CDATA[Hi Fault compare: Short Circuit / signal over-range.]]>
                </Comment>
                <Text>
                  <![CDATA[GEQ(Val,HiFaultSP)OTE(HiFaultRaw);]]>
                </Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment>
                  <![CDATA[Optional Diagnostic / Optical Fault Window (e.g. Open-path gas detector optical obscuration).]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(HasFaultWin)GEQ(Val,FaultWinLo)LEQ(Val,FaultWinHi)OTE(Fault1);]]>
                </Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment>
                  <![CDATA[Latch Lo Alarm until SystemReset; forced off when HasLoAlarm=0.]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(HasLoAlarm)[XIC(LoAlarmRaw),XIC(ALL)]XIO(SystemReset)OTE(ALL);]]>
                </Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment>
                  <![CDATA[Lo Alarm Inhibit masking.]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(ALL)XIO(Inhibit)OTE(ALLI);]]>
                </Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment>
                  <![CDATA[Latch Hi Alarm until SystemReset; interlocked with AllowHiLatch.]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(HasHiAlarm)[XIC(HiAlarmRaw),XIC(ALH)]XIO(SystemReset)XIC(AllowHiLatch)OTE(ALH);]]>
                </Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment>
                  <![CDATA[Hi Alarm Inhibit masking (feeds Cause & Effect / shutdown logic).]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(ALH)XIO(Inhibit)OTE(ALHI);]]>
                </Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment>
                  <![CDATA[First-Up trip latch: latches when an uninhibited Hi Alarm causes a system action.]]>
                </Comment>
                <Text>
                  <![CDATA[[XIC(AnyActions)XIC(ALHI),XIC(FRUP)]XIO(SystemReset)OTE(FRUP);]]>
                </Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment>
                  <![CDATA[Open circuit fault 3-second (3000 ms) debounce timer to filter momentary loop glitches.]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(LoFaultRaw)TON(TMR_OC,3000,0);]]>
                </Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Comment>
                  <![CDATA[Open circuit fault output (live / unlatched after 3 s debounce).]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(TMR_OC.DN)OTE(OC);]]>
                </Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Comment>
                  <![CDATA[Short circuit fault 3-second (3000 ms) debounce timer to filter momentary loop glitches.]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(HiFaultRaw)TON(TMR_SC,3000,0);]]>
                </Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Comment>
                  <![CDATA[Short circuit fault output (live / unlatched after 3 s debounce).]]>
                </Comment>
                <Text>
                  <![CDATA[XIC(TMR_SC.DN)OTE(SC);]]>
                </Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
