    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="AOI_AI_Channel" Revision="2.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2026-11-12T12:00:00.000Z" CreatedBy="conversion" EditedDate="2026-11-12T13:00:00.000Z" EditedBy="conversion" SoftwareRevision="v17.00">
        <Description>
<![CDATA[Add-On Instruction: AOI_AI_Channel (Analog Channel Processing Block)
Encapsulates 4-20mA signal conditioning, NAMUR NE 43 diagnostic fault thresholds, low/high alarm setpoint comparisons, manual maintenance inhibit masking, first-out chronological trip capture, and 3000 ms debounce timers for open/short circuits.]]>
        </Description>
        <Parameters>
          <Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false"/>
          <Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false"/>
          <Parameter Name="PV" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              Scaled Process Variable directly from Analog Input Card (Engineering Units)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="LoAlarmSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              Low Alarm Setpoint (Engineering Units)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="HiAlarmSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              High Alarm Setpoint (Engineering Units)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="LoFaultSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              Low Fault / Under-range Setpoint (Open Circuit)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="HiFaultSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              High Fault / Over-range Setpoint (Short Circuit)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="LoAlarmLE" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              0 = GEQ (High-acting/gas), 1 = LEQ (Low-acting/pressure trip)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="HasLoAlarm" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              1 = Enable Low Alarm latch, 0 = Mask Low Alarm (e.g. Flame loops)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="HasHiAlarm" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              1 = Enable High Alarm latch, 0 = Mask High Alarm (e.g. Low-only pressure PST_7002_001)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="AllowHiLatch" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              1 = Normal, 0 = Block Hi Alarm latching (Flame detector interlock)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="Inhibit" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              Channel Inhibit command
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="SystemReset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              System Reset command (unlatches alarms)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="AnyActions" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              System Any Actions active (latches First-Up)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="HasFaultWin" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              1 = Enable Diagnostic/Optical Fault Window, 0 = Disabled
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="FaultWinLo" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              Diagnostic Fault Window Lower Boundary
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="FaultWinHi" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              Diagnostic Fault Window Upper Boundary
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="Val" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="false">
            <Description>
<![CDATA[
              Process Value output for HMI/SCADA
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="ALL" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              Low Alarm latched
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="ALLI" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              Low Alarm Inhibit-masked
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="ALH" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              High Alarm latched
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="ALHI" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              High Alarm Inhibit-masked
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="FRUP" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              First-Up trip latched
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="OC" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              Open Circuit / Under-range fault (live)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="SC" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              Short Circuit / Over-range fault (live)
            ]]>
            </Description>
          </Parameter>
          <Parameter Name="Fault1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false">
            <Description>
<![CDATA[
              Optical / Diagnostic fault inside window (live)
            ]]>
            </Description>
          </Parameter>
        </Parameters>
        <LocalTags>
          <LocalTag Name="LoAlarmRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="HiAlarmRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="LoFaultRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="HiFaultRaw" DataType="BOOL" Radix="Decimal"/>
          <LocalTag Name="TMR_OC" DataType="TIMER"/>
          <LocalTag Name="TMR_SC" DataType="TIMER"/>
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL">
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment>
<![CDATA[Analog Channel Input Staging: Passes scaled Process Variable (PV) from 1756-IF16/IF8H on-card scaling directly into internal engineering variable 'Val' (0-100% LEL, 0-16 bar, etc.).]]>
                </Comment>
                <Text>
<![CDATA[
                  MOV(PV,Val);
                ]]>
                </Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment>
<![CDATA[Low Alarm Threshold Evaluation: Compares 'Val' against 'LoAlarmSP'. Evaluates GEQ (>=) for standard high-acting gas detectors (LoAlarmLE=0, e.g. 20% LEL), or LEQ (<=) for low-acting transmitters (LoAlarmLE=1, e.g. air accumulator pressure low trip at 50 PSI). Sets internal unlatched flag 'LoAlarmRaw'.]]>
                </Comment>
                <Text>
<![CDATA[
                  [XIO(LoAlarmLE)GEQ(Val,LoAlarmSP),XIC(LoAlarmLE)LEQ(Val,LoAlarmSP)]OTE(LoAlarmRaw);
                ]]>
                </Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment>
<![CDATA[High Alarm Threshold Evaluation: Compares 'Val' >= 'HiAlarmSP' (e.g. 30% or 60% LEL combustible gas). Sets internal unlatched flag 'HiAlarmRaw'. This signal feeds the high gas / fire trip matrix.]]>
                </Comment>
                <Text>
<![CDATA[
                  GEQ(Val,HiAlarmSP)OTE(HiAlarmRaw);
                ]]>
                </Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment>
<![CDATA[NAMUR NE 43 Open Circuit / Signal Under-Range Detection: Compares 'Val' <= 'LoFaultSP' (typically -10.0%, corresponding to loop current < 3.6 mA / 400 counts on 12-bit ADC). Detects broken wire, disconnected sensor, or field transmitter power loss. Sets internal flag 'LoFaultRaw'.]]>
                </Comment>
                <Text>
<![CDATA[
                  LEQ(Val,LoFaultSP)OTE(LoFaultRaw);
                ]]>
                </Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment>
<![CDATA[NAMUR NE 43 Short Circuit / Signal Over-Range Detection: Compares 'Val' >= 'HiFaultSP' (typically 98.0% to 102.0%, corresponding to loop current > 21.0 mA). Detects field wiring short circuit to 24VDC or transmitter failure. Sets internal flag 'HiFaultRaw'.]]>
                </Comment>
                <Text>
<![CDATA[
                  GEQ(Val,HiFaultSP)OTE(HiFaultRaw);
                ]]>
                </Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment>
<![CDATA[Optical Fault Window Detection (Open Path Detector): When HasFaultWin=1, checks if 'Val' is within the optical obscuration window (FaultWinLo <= Val <= FaultWinHi, -0.78 to -0.47 LEL*m). Detects dirty optics, heavy fog, or misaligned reflector without triggering a false combustible gas alarm. Sets 'Fault1'.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(HasFaultWin)GEQ(Val,FaultWinLo)LEQ(Val,FaultWinHi)OTE(Fault1);
                ]]>
                </Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment>
<![CDATA[Low Alarm Latch Management: When channel has low alarm enabled (HasLoAlarm=1), latches 'ALL' upon rising edge of 'LoAlarmRaw'. The latch remains actively held until cleared by master 'SystemReset' after process normalizes.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(HasLoAlarm)[XIC(LoAlarmRaw),XIC(ALL)]XIO(SystemReset)OTE(ALL);
                ]]>
                </Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment>
<![CDATA[Low Alarm Maintenance Inhibit Masking: Passes latched alarm 'ALL' to active alarm 'ALLI' only when manual channel inhibit key/bit 'Inhibit' is OFF (0). If an engineer places this channel in inhibit, ALLI is suppressed to prevent nuisance trips during sensor calibration.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(ALL)XIO(Inhibit)OTE(ALLI);
                ]]>
                </Text>
              </Rung>
              <Rung Number="8" Type="N">
                <Comment>
<![CDATA[High Alarm Latch Management: When channel has high alarm enabled (HasHiAlarm=1) and high latching is permitted (AllowHiLatch=1), latches 'ALH' upon rising edge of 'HiAlarmRaw'. Remains latched until master 'SystemReset'.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(HasHiAlarm)[XIC(HiAlarmRaw),XIC(ALH)]XIO(SystemReset)XIC(AllowHiLatch)OTE(ALH);
                ]]>
                </Text>
              </Rung>
              <Rung Number="9" Type="N">
                <Comment>
<![CDATA[High Alarm Maintenance Inhibit Masking: Passes latched alarm 'ALH' to trip signal 'ALHI' only when 'Inhibit' is OFF (0). Uninhibited high alarm ALHI directly initiates plant emergency shutdown (ESD) in the Cause & Effect matrix.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(ALH)XIO(Inhibit)OTE(ALHI);
                ]]>
                </Text>
              </Rung>
              <Rung Number="10" Type="N">
                <Comment>
<![CDATA[First-Up (First-Out) Chronological Event Latch: Captures the primary initiating cause of a shutdown. If an uninhibited high alarm ALHI triggers a plant trip (AnyActions=1), latches 'FRUP' until master 'SystemReset'. Allows operators to determine which detector tripped first during an incident.]]>
                </Comment>
                <Text>
<![CDATA[
                  [XIC(AnyActions)XIC(ALHI),XIC(FRUP)]XIO(SystemReset)OTE(FRUP);
                ]]>
                </Text>
              </Rung>
              <Rung Number="11" Type="N">
                <Comment>
<![CDATA[Open Circuit / Broken Wire Fault Debounce Timer: 3000 ms on-delay timer (TMR_OC). Filters out transient voltage dips, electrical switching spikes, or momentary loop noise before declaring a hard wire-break fault.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(LoFaultRaw)TON(TMR_OC,3000,0);
                ]]>
                </Text>
              </Rung>
              <Rung Number="12" Type="N">
                <Comment>
<![CDATA[Open Circuit Fault Output: Driven by timer done bit TMR_OC.DN. Live, self-resetting fault bit 'OC' indicates sustained open circuit / wire-break on this analog loop. Feeds panel trouble lamp and common fault voting.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(TMR_OC.DN)OTE(OC);
                ]]>
                </Text>
              </Rung>
              <Rung Number="13" Type="N">
                <Comment>
<![CDATA[Short Circuit / Loop Saturation Fault Debounce Timer: 3000 ms on-delay timer (TMR_SC). Filters out transient cable surges before confirming a hard short circuit.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(HiFaultRaw)TON(TMR_SC,3000,0);
                ]]>
                </Text>
              </Rung>
              <Rung Number="14" Type="N">
                <Comment>
<![CDATA[Short Circuit Fault Output: Driven by timer done bit TMR_SC.DN. Live fault bit 'SC' indicates sustained short circuit / over-range (>21 mA) on this analog loop.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(TMR_SC.DN)OTE(SC);
                ]]>
                </Text>
              </Rung>
            </RLLContent>
          </Routine>
        </Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
