                  MOV(MCM_IN[82],MB_FT6401_RPM);
                ]]>
                </Text>
              </Rung>
              <Rung Number="25" Type="N">
                <Comment>
<![CDATA[Common Process Alarm PA-001 Generation: Evaluates shutdown flags from pump annunciators (P2300, P2400, P2500, P2600, P3800, P3900). If ANY process pump is in shutdown, drives PA_001_Process (TB-08: 47-48).]]>
                </Comment>
                <Text>
<![CDATA[
                  [XIC(P2300_SHUTDOWN),XIC(P2400_SHUTDOWN),XIC(P2500_SHUTDOWN),XIC(P2600_SHUTDOWN),XIC(P3800_SHUTDOWN),XIC(P3900_SHUTDOWN)]OTE(PA_001_Process);
                ]]>
