                  MOV(MCM_IN[11],MB_P2400_ALMCODE);
                ]]>
                </Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment>
<![CDATA[Power Oil Pump P2400: Copies Modbus register MCM_IN[12] to engine running speed register MB_P2400_RPM.]]>
                </Comment>
                <Text>
