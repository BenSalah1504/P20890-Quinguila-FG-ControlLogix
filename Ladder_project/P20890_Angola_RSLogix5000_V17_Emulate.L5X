          <Routine Name="IO_Mapping_Out" Type="RLL">
            <Description>
<![CDATA[Subroutine: IO_Mapping_Out (Physical Slot Output Buffer Table)
Writes conditioned application commands to physical Slot 8 1756-OB32 24VDC sourcing output module, enforcing terminal-by-terminal alignment with EPPM wiring schedule TB-08.]]>
            </Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment>
<![CDATA[DO Slot 8 Point 0 <- PumpShutdown (Fail-Safe Active-Low): Main Process Pumps Emergency Trip Relay (TB-08: 01-02). Held HIGH (1) in healthy operation; drops LOW (0) on emergency shutdown or control power failure.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(PumpShutdown)OTE(Local:8:O.Data.0);
                ]]>
                </Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment>
<![CDATA[DO Slot 8 Point 1 <- EY_6401_001_002 (Fail-Safe Active-Low): Fuel Gas Emergency Shut-Off Valve Solenoids (TB-08: 03-04). Held HIGH (1) to keep fuel gas valves open; de-energizes LOW (0) on confirmed fire/gas trip.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(EY_6401_001_002)OTE(Local:8:O.Data.1);
                ]]>
                </Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment>
<![CDATA[DO Slot 8 Point 2 <- SA_7404_001_002: Main Plant Acoustic Alarm Horn / Siren 7404-001/002 (TB-08: 05-06). Energized on confirmed fire, gas high, or process emergency. Silenced by panel Mute PB.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(SA_7404_001_002)OTE(Local:8:O.Data.2);
                ]]>
                </Text>
              </Rung>
              <Rung Number="3" Type="N">
                <Comment>
<![CDATA[DO Slot 8 Point 3 <- Pump_A_PulsOut: Electric Fire Pump A Remote Start Momentary Pulse Output (TB-08: 07-08). Delivers 1.5-second pulse to MCC motor starter contactor.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(Pump_A_PulsOut)OTE(Local:8:O.Data.3);
                ]]>
                </Text>
              </Rung>
              <Rung Number="4" Type="N">
                <Comment>
<![CDATA[('DO Slot 8 Point 4 <- PUMP_A: Electric Fire Pump A Continuous Run Permissive Interlock (TB-08: 09-10).',)]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(PUMP_A)OTE(Local:8:O.Data.4);
                ]]>
                </Text>
              </Rung>
              <Rung Number="5" Type="N">
                <Comment>
<![CDATA[DO Slot 8 Point 5 <- Pump_B_Start_PulsOut: Diesel Fire Pump B Remote Start Momentary Pulse Output (TB-08: 11-12). Delivers 1.5-second crank pulse to Murphy engine control panel.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(Pump_B_Start_PulsOut)OTE(Local:8:O.Data.5);
                ]]>
                </Text>
              </Rung>
              <Rung Number="6" Type="N">
                <Comment>
<![CDATA[('DO Slot 8 Point 6 <- PUMP_B_START: Diesel Fire Pump B Continuous Start Command Relay (TB-08: 13-14).',)]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(PUMP_B_START)OTE(Local:8:O.Data.6);
                ]]>
                </Text>
              </Rung>
              <Rung Number="7" Type="N">
                <Comment>
<![CDATA[DO Slot 8 Point 7 <- PUMP_B_STOP: Diesel Fire Pump B Fuel Rack Stop Solenoid Command (TB-08: 15-16). Energize to stop diesel engine when firewater demand clears.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(PUMP_B_STOP)OTE(Local:8:O.Data.7);
                ]]>
                </Text>
