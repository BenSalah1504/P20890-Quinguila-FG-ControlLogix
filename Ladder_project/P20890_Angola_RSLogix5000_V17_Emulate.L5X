              <Rung Number="35" Type="N">
                <Comment>
<![CDATA[Rising Edge Detection: Controller Minor/Major Fault (SYS_HRD_FLT) -> One-shot System_Sound34.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(SYS_HRD_FLT)ONS(System_Sound34_OS)OTE(System_Sound34);
                ]]>
                </Text>
              </Rung>
              <Rung Number="36" Type="N">
                <Comment>
<![CDATA[Rising Edge Detection: Lost Connection to I/O Module (SYS_LOS_IOM) -> One-shot System_Sound35.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(SYS_LOS_IOM)ONS(System_Sound35_OS)OTE(System_Sound35);
                ]]>
                </Text>
              </Rung>
              <Rung Number="37" Type="N">
                <Comment>
<![CDATA[Rising Edge Detection: Lost Communication to Expansion Rack (SYS_LOS_RCK) -> One-shot System_Sound36.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(SYS_LOS_RCK)ONS(System_Sound36_OS)OTE(System_Sound36);
                ]]>
                </Text>
              </Rung>
              <Rung Number="38" Type="N">
                <Comment>
<![CDATA[Rising Edge Detection: RTC Battery Low Voltage (SYS_LOW_BAT) -> One-shot System_Sound37.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(SYS_LOW_BAT)ONS(System_Sound37_OS)OTE(System_Sound37);
                ]]>
                </Text>
              </Rung>
              <Rung Number="39" Type="N">
                <Comment>
<![CDATA[Rising Edge Detection: Diesel Pump B Maintenance Inhibit Engaged -> One-shot System_Sound40.]]>
                </Comment>
                <Text>
<![CDATA[
                  XIC(Pump_B_Inhibited_AL)ONS(System_Sound40_OS)OTE(System_Sound40);
                ]]>
                </Text>
              </Rung>
              <Rung Number="40" Type="N">
                <Comment>
<![CDATA[Common PLC Fault Annunciator Latch: Latches PLC_Fault_INT upon any CPU, memory, battery, or I/O module fault.]]>
                </Comment>
                <Text>
<![CDATA[
                  [XIC(System_Sound32),XIC(System_Sound33),XIC(System_Sound35),XIC(System_Sound37),XIC(System_Sound34),XIC(System_Sound36),XIC(System_Sound40)]OTL(PLC_Fault_INT);
                ]]>
                </Text>
              </Rung>
              <Rung Number="41" Type="N">
                <Comment>
