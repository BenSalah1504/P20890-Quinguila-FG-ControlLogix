      <Tag Name="TMR_T_MIN" TagType="Base" DataType="TIMER">
        <Description>
<![CDATA[
          Helper TIMER for the T_MIN_PULSE generator. TON preset 60000 ms, self-resetting on its own .DN (free-running 60 s ramp); T_MIN_PULSE is taken from .ACC < 30000.
        ]]>
        </Description>
      </Tag>
      <Tag Name="TMR_T_SEC" TagType="Base" DataType="TIMER">
        <Description>
<![CDATA[
          Helper TIMER for the T_SEC_PULSE generator. TON preset 1000 ms, self-resetting on its own .DN (free-running 1 s ramp); T_SEC_PULSE is taken from .ACC < 500.
        ]]>
        </Description>
      </Tag>
      <Tag Name="T_MIN_PULSE" TagType="Base" DataType="BOOL">
        <Description>
<![CDATA[
          Generated replacement for GE system bit #T_MIN %S00006 ('1.0 minute timer contact'): free-running 60 s square wave, 30 s TRUE / 30 s FALSE. Same tag already declared for the Logic routine - this entry only makes Protect self-contained.
        ]]>
        </Description>
      </Tag>
      <Tag Name="T_SEC_PULSE" TagType="Base" DataType="BOOL">
        <Description>
<![CDATA[
          Generated replacement for GE system bit #T_SEC (%S00005): free-running 1 s square wave, 0.5 s TRUE / 0.5 s FALSE. Declared here because the VersaMax supplied it in hardware.
        ]]>
        </Description>
      </Tag>
      <Tag Name="OS_AnyActions" TagType="Base" DataType="BOOL">
        <Description>
<![CDATA[
          ONS storage bit for the System_AnyActions first-up pulse (CE_LOG last rung)
        ]]>
        </Description>
      </Tag>
      <Tag Name="Sys_MinorFaultBits" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
        <Description>
<![CDATA[
          Copy of FaultLog.MinorFaultBits (GSV) - bit3 I/O, bit4 program, bit6 watchdog, bit10 battery
        ]]>
        </Description>
      </Tag>
      <Tag Name="Sys_FaultClearZero" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
        <Description>
<![CDATA[
          Constant 0 written by SSV to FaultLog.MinorFaultBits on System_Reset (replaces GE SVC_REQ 14)
        ]]>
        </Description>
      </Tag>
